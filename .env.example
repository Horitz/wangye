# Local development uses SQLite when DATABASE_URL is empty.
# Copy to .env.local. Never commit .env.local or paste credentials into chat.
# Supabase: Connect > Session pooler (port 5432). URL-encode the password.
DATABASE_URL=
# Optional: PEM from Supabase Database Settings > SSL Configuration.
# The official Supabase Root 2021 CA is bundled; set this only for a rotated/custom CA.
# A quoted PEM with literal \n separators is accepted. Keep TLS verification enabled.
SUPABASE_DB_CA_CERT=

# Supabase project URL and a SERVER-ONLY Storage key; no NEXT_PUBLIC_ prefix.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Legacy service_role key may be used instead of SUPABASE_SECRET_KEY.
SUPABASE_SERVICE_ROLE_KEY=
STUDENTPATH_MEDIA_BUCKET=studentpath-media

# Final https origin, no trailing path, e.g. https://studentpath.vercel.app
# Vercel's own deployment URL also works without setting this during first setup.
STUDENTPATH_ORIGIN=

